  command = "C:\Users\Paddy\Documents\My Games\WACKYRACES\ps2-native-recomp-0.0.5\tools\portable\cmake\bin\cmake.exe" -E cmake_ninja_dyndep --tdi=CMakeFiles\ps2thbasetest.dir\CXXDependInfo.json --lang=CXX --modmapfmt=clang --dd=$out @$out.rsp
